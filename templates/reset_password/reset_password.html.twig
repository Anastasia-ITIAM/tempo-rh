{% extends 'base.html.twig' %}

{% block title %}Réinitialisation du mot de passe{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'reset_password', 'bootstrap_entry']) }}
{% endblock %}

{% block body %}

    <div class="login-page">

        <div class="login-container-reset-password">
            <div class="login-logo">
                <img src="{{ asset('images/logo.png') }}" alt="TempoRH">
            </div>

            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="error-message" role="alert">
                    Lien invalide. Réessayez.
                </div>
            {% endfor %}

            <h3>Réinitialisez votre mot de passe</h3>

            {{ form_start(requestForm) }}
            {{ form_row(requestForm.email, {
                label: 'Email', attr: {class: 'form-control'},
            }) }}

            <div class="forgot-password">
                <small>Entrez votre adresse e-mail et nous vous enverrons un lien pour réinitialiser votre mot de passe.</small>
            </div>

            <button class="btn-login-reset-password">Envoyer le lien de réinitialisation</button>
            {{ form_end(requestForm) }}
            <div class="forgot-password">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </div>
        </div>
    </div>
{% endblock %}
