{% extends 'base.html.twig' %}

{% block title %}Réinitialisez votre mot de passe{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'new_password', 'bootstrap_entry']) }}
{% endblock %}

{% block body %}

    <div class="login-page">
        <div class="login-container-reset">
            <div class="login-logo-reset">
                <img src="{{ app_logo() }}" alt="TempoRH">
            </div>

            <h3>Réinitialisez votre mot de passe</h3>

            {% for flash_error in app.flashes('reset_password_error') %}
                <div class="error-message-password">{{ flash_error }}</div>
            {% endfor %}

            {{ form_start(resetForm) }}

            <div class="form-group text-white">
                {{ form_label(resetForm.plainPassword.first, 'Nouveau mot de passe') }}
                <div class="password-wrapper" data-controller="toggle-password">
                    {{ form_widget(resetForm.plainPassword.first) }}

                    <button type="button"
                            class="toggle-password-btn"
                            data-action="click->toggle-password#toggle"
                        aria-label="Afficher le mot de passe">
                        <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>
                <div>
                    {{ form_errors(resetForm.plainPassword.first) }}
                </div>

                {{ form_label(resetForm.plainPassword.second, 'Répétez le mot de passe') }}
                <div class="password-wrapper" data-controller="toggle-password">
                    {{ form_widget(resetForm.plainPassword.second) }}

                    <button type="button"
                            class="toggle-password-btn"
                            data-action="click->toggle-password#toggle"
                        aria-label="Afficher le mot de passe">
                        <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                        <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                    </button>
                </div>                <div>
                    {{ form_errors(resetForm.plainPassword.second) }}
                </div>

                <div style="color:#fff;">
                    {{ form_errors(resetForm.plainPassword) }}
                </div>
            </div>

            <button type="submit" class="btn-login-reset">
                Réinitialiser le mot de passe
            </button>

            {{ form_end(resetForm) }}

            <div class="forgot-password">
                <a href="{{ path('app_login') }}">Retour à la connexion</a>
            </div>
        </div>
    </div>
{% endblock %}
