{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block body_class %}login-page{% endblock %}

{% block javascripts %}
 {% block importmap %}
     {{ importmap(['app', 'login', 'bootstrap_entry']) }}
 {% endblock %}
{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="login-logo">
            <img src="{{ asset('images/logo-white.png') }}" alt="TempoRH">
        </div>

        {% if error %}
            <div class="error-message">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form action="{{ path('app_login') }}" method="post">
{# <label for="username">Email:</label> #}
            <input type="text" id="username" name="_username" placeholder="Email" value="{{ last_username }}" required>

{# <label for="password">Mot de passe:</label> #}

            <div class="password-wrapper" data-controller="toggle-password">
                <input type="password" id="password" name="_password" placeholder="Mot de passe" required>

                <button type="button"
                        class="toggle-password-btn"
                        data-action="click->toggle-password#toggle">
                    👁
                </button>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="forgot-password">
                <a href="{{ path('app_forgot_password_request') }}">
                    Mot de passe oublié ?
                </a>
            </div>

            <button class="btn-login" type="submit">Se connecter</button>
        </form>
    </div>
{% endblock %}
