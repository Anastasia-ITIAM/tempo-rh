{% extends 'base.html.twig' %}

{% block title %}Se connecter{% endblock %}

{% block body_class %}login-page{% endblock %}

{% block javascripts %}
 {% block importmap %}
     {{ importmap(['app', 'login', 'bootstrap_entry']) }}
 {% endblock %}
{% endblock %}

{% block body %}
    <div class="login-container">
        <div class="login-logo">
            <img src="{{ app_logo() }}" alt="TempoRH">
        </div>

        {% if error %}
            <div class="error-message">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form action="{{ path('app_login') }}" method="post">
{# <label for="username">Email:</label> #}
            <input type="text" id="username" name="_username" placeholder="Email" value="{{ last_username }}" required>

{# <label for="password">Mot de passe:</label> #}

            <div class="password-wrapper" data-controller="toggle-password">
                <input type="password" id="password" name="_password" placeholder="Mot de passe" required>

                <button type="button"
                        class="toggle-password-btn"
                        data-action="click->toggle-password#toggle"
                        aria-label="Afficher le mot de passe">
                    <svg class="icon-eye" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
                    <svg class="icon-eye-off" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                </button>
            </div>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

            <div class="forgot-password">
                <a href="{{ path('app_forgot_password_request') }}">
                    Mot de passe oublié ?
                </a>
            </div>

            <button class="btn-login" type="submit">Se connecter</button>
        </form>
    </div>
{% endblock %}
