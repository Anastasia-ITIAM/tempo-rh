<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}TempoRH{% endblock %}</title>
    <link rel="icon" type="image/svg+xml" href="{{ branding_logo_url() }}">
    {{ include('settings/theme_colors.html.twig') }}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">

{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} flash-message">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

{% block body %}
{% endblock %}

</body>
</html>
