{% extends '@EasyAdmin/layout.html.twig' %}

{% block importmap %}
    {{ importmap(['app', 'admin_timesheet_week_detail', 'admin_week_detail_timesheet_css']) }}
{% endblock %}

{% block content_title %}
    Détail - Semaine du {{ timesheetWeek.startDate|date('d/m/Y') }}
{% endblock %}

{% block content %}
    {% set totalHours = 0 %}
    {% for entry in timesheetWeek.timeSheetEntries %}
        {% set totalHours = totalHours + entry.hours %}
    {% endfor %}
    {% set weekEnd = timesheetWeek.startDate|date_modify('+6 days') %}
    {% set dayFullNames = {1: 'Lundi', 2: 'Mardi', 3: 'Mercredi', 4: 'Jeudi', 5: 'Vendredi', 6: 'Samedi', 7: 'Dimanche'} %}
    {% set isSubmitted = timesheetWeek.status.value == 'soumis' %}

    <div class="container mt-4">

        <!-- Haut de page : retour uniquement -->
        <div class="mb-4 text-end">
            <a href="{{ path('admin_timesheet_dashboard') }}" class="btn btn-secondary">
                ← Retour
            </a>
        </div>

        <!-- Informations générales + Historique -->
        <div class="row mb-4 g-3">
            <div class="col-md-6">
                <div class="card ts-card h-100">
                    <div class="ts-card-header">Informations générales</div>
                    <div class="card-body">
                        <div class="ts-user">
                            <div class="ts-user-name">{{ timesheetWeek.user.firstName }} {{ timesheetWeek.user.lastName }}</div>
                            <div class="ts-user-period">
                                Semaine du {{ timesheetWeek.startDate|date('d/m') }} au {{ weekEnd|date('d/m/Y') }}
                            </div>
                        </div>

                        <dl class="ts-info-list">
                            <dt>Statut</dt>
                            <dd>
                                <span class="badge badge-{{ timesheetWeek.status.name|lower }}">
                                    {{ timesheetWeek.status.label() }}
                                </span>
                            </dd>

                            <dt>Total</dt>
                            <dd><strong>{{ totalHours|number_format(2, ',', ' ') }} h</strong></dd>

                            {% if timesheetWeek.submittedAt %}
                                <dt>Soumise le</dt>
                                <dd>{{ timesheetWeek.submittedAt|date('d/m/Y à H:i') }}</dd>
                            {% endif %}
                        </dl>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card ts-card h-100">
                    <div class="ts-card-header">Historique</div>
                    <div class="card-body ts-history-body">
                        {% if timesheetWeek.history|length > 0 %}
                            <ul class="history-list">
                                {% for entry in timesheetWeek.history %}
                                    <li class="history-entry">
                                        <div class="history-entry-header">
                                            <span class="badge badge-{{ entry.status.name|lower }}">{{ entry.status.label() }}</span>
                                            <span class="history-entry-meta">
                                                par <strong>{{ entry.actionBy.firstName }} {{ entry.actionBy.lastName }}</strong>
                                                le {{ entry.createdAt|date('d/m/Y à H:i') }}
                                            </span>
                                        </div>
                                        {% if entry.comment %}
                                            <div class="history-entry-comment">{{ entry.comment }}</div>
                                        {% endif %}
                                    </li>
                                {% endfor %}
                            </ul>
                        {% else %}
                            <div class="ts-history-empty">
                                <span>Aucun historique pour le moment</span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <!-- Entrées de temps -->
        <div class="card ts-card mb-4">
            <div class="ts-card-header d-flex justify-content-between align-items-center">
                <span>Entrées de temps</span>
                <span class="week-total-bar">Total de la semaine : <strong>{{ totalHours|number_format(2, ',', ' ') }}h</strong></span>
            </div>
            <div class="card-body">
                <table class="table table-striped entries-table">
                    <thead>
                    <tr>
                        <th>Date</th>
                        <th>Client</th>
                        <th>Projet</th>
                        <th>Tâche</th>
                        <th class="text-end">Heures</th>
                        <th>Commentaire</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for entry in timesheetWeek.timeSheetEntries %}
                        <tr>
                            <td><strong>{{ dayFullNames[entry.date|date('N')] }} {{ entry.date|date('d/m/Y') }}</strong></td>
                            <td>
                                {% if entry.client %}
                                    {{ entry.client.name }}
                                    {% if entry.client.deletedAt %}<span class="badge bg-secondary ms-1">Supprimé</span>{% endif %}
                                {% else %}
                                    <span class="text-muted">(client supprimé)</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if entry.project %}
                                    {{ entry.project.name }}
                                    {% if entry.project.deletedAt %}<span class="badge bg-secondary ms-1">Supprimé</span>{% endif %}
                                {% else %}
                                    <span class="text-muted">(projet supprimé)</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if entry.task %}
                                    {{ entry.task.name }}
                                    {% if entry.task.deletedAt %}<span class="badge bg-secondary ms-1">Supprimée</span>{% endif %}
                                {% else %}
                                    <span class="text-muted">(tâche supprimée)</span>
                                {% endif %}
                            </td>
                            <td class="text-end"><strong>{{ entry.hours|number_format(2, ',', ' ') }}h</strong></td>
                            <td>{{ entry.comment ?: '-' }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted">Aucune entrée de temps</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>

                {% if timesheetWeek.timeSheetEntries|length > 0 %}
                    {% set weekDays = [] %}
                    {% for i in 0..6 %}
                        {% set weekDays = weekDays|merge([timesheetWeek.startDate|date_modify('+' ~ i ~ ' day')]) %}
                    {% endfor %}

                    <h6 class="mt-4">Total par jour</h6>
                    <table class="table table-sm table-bordered text-center mb-0">
                        <thead>
                        <tr>
                            {% for day in weekDays %}
                                <th>{{ dayFullNames[day|date('N')] }}<br><span class="text-muted fw-normal">{{ day|date('d/m') }}</span></th>
                            {% endfor %}
                        </tr>
                        </thead>
                        <tbody>
                        <tr>
                            {% for day in weekDays %}
                                {% set dateKey = day|date('Y-m-d') %}
                                {% set dayTotal = 0 %}
                                {% for entry in timesheetWeek.timeSheetEntries %}
                                    {% if entry.date|date('Y-m-d') == dateKey %}
                                        {% set dayTotal = dayTotal + entry.hours %}
                                    {% endif %}
                                {% endfor %}
                                <td><strong>{{ dayTotal|number_format(2, ',', ' ') }}h</strong></td>
                            {% endfor %}
                        </tr>
                        </tbody>
                        <tfoot>
                        <tr>
                            <td colspan="7" class="week-total-footer">
                                Total de la semaine : <strong>{{ totalHours|number_format(2, ',', ' ') }}h</strong>
                            </td>
                        </tr>
                        </tfoot>
                    </table>
                {% endif %}
            </div>
        </div>

        <!-- Bas de page : retour + validation / rejet -->
        <div class="ts-bottom-actions">
            <a href="{{ path('admin_timesheet_dashboard') }}" class="btn btn-secondary">
                ← Retour
            </a>
            {% if isSubmitted %}
                <button type="button" class="btn btn-success" id="approveBtnDetail"
                        data-timesheet-id="{{ timesheetWeek.id }}"
                        data-user-name="{{ timesheetWeek.user.firstName }} {{ timesheetWeek.user.lastName }}"
                        data-start-date="{{ timesheetWeek.startDate|date('d/m/Y') }}"
                        data-total-hours="{{ totalHours|number_format(2, ',', ' ') }}h">
                    Valider
                </button>
                <button type="button" class="btn btn-danger" id="rejectBtnDetail" data-timesheet-id="{{ timesheetWeek.id }}">
                    Rejeter
                </button>
            {% endif %}
        </div>

    </div>

    {# ========== MODALES ========== #}

    {# Modal Approuver #}
    <div id="approveModal" class="ts-modal">
        <div class="ts-modal-content">
            <div class="ts-modal-header">
                <h3>Approuver cette feuille ?</h3>
            </div>
            <div class="ts-modal-body">
                <div id="approveSummary"></div>
            </div>
            <div class="ts-modal-footer">
                <button type="button" class="btn btn-secondary ts-modal-close">Annuler</button>
                <button type="button" class="btn btn-success" id="confirmApproveBtnDetail">Valider</button>
            </div>
        </div>
    </div>

    {# Modal Rejeter #}
    <div id="rejectModal" class="ts-modal">
        <div class="ts-modal-content">
            <div class="ts-modal-header">
                <h3>Rejeter cette feuille ?</h3>
            </div>
            <div class="ts-modal-body">
                <label for="rejectReason" class="form-label"></label>
                <textarea id="rejectReason" class="form-control" rows="5" required
                          placeholder="Raison du rejet..."></textarea>
            </div>
            <div class="ts-modal-footer">
                <button type="button" class="btn btn-secondary ts-modal-close">Annuler</button>
                <button type="button" class="btn btn-danger" id="confirmRejectBtnDetail">Rejeter</button>
            </div>
        </div>
    </div>
{% endblock %}