{% extends 'notification/base.html.twig' %}

{% block title %}La feuille de temps rejetée{% endblock %}

{% block body %}
    <div class="email-wrapper">
        <div class="email-content">

            <div class="login-logo">
                <img src="{{ absolute_url(asset('images/logo.png')) }}"
                     alt="TempoRH" width="150">
            </div>

            <h2>Votre feuille de temps a été rejetée</h2>

            <p>
                Bonjour <span class="highlight">{{ employeeName }}</span>,<br>
                Votre feuille de temps a été examinée et a été <b>rejetée</b>.
            </p>

            {% if adminComment %}
                <p><b>Commentaire de l'admin :</b> {{ adminComment }}</p>
            {% endif %}

            <p>
                Vous pouvez consulter les détails en vous connectant à votre espace personnel :
                <br>
                <a href="{{ absolute_url(path('app_login')) }}">Portail ERP</a>
            </p>

            <div class="footer">
                &copy; {{ 'now'|date('Y') }} TempoRH. Tous droits réservés.
            </div>

        </div>
    </div>
{% endblock %}
