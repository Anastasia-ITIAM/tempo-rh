{% extends 'notification/base.html.twig' %}

{% block title %}Nouvelle note de frais{% endblock %}

{% block body %}
<div class="email-wrapper">
    <div class="email-content">

        <div class="login-logo">
            <img src="{{ absolute_url(branding_logo_url()) }}"
                 alt="TempoRH" width="150">
        </div>

        <h2>Une nouvelle note de frais a été créée par l’administrateur</h2>

        <p>La note de frais a été créée pour l’employé <span class="highlight">{{ employee }}</span>.</p>

        <p>
            Vous pouvez consulter les détails dans l’interface d’administration :
            <br>
            <a href="{{ absolute_url(path('app_login')) }}">Portail ERP</a>
        </p>

        <div class="footer">
            &copy; {{ 'now'|date('Y') }} TempoRH. Tous droits réservés.
        </div>

    </div>
</div>
{% endblock %}
