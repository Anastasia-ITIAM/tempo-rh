{% extends 'notification/base.html.twig' %}

{% block title %}Demande d'annulation{% endblock %}

{% block body %}
<div class="email-wrapper">
    <div class="email-content">

        <div class="login-logo">
            <img src="{{ absolute_url(asset('images/logo.png')) }}"
                 alt="TempoRH" width="150">
        </div>

        <h2>Une nouvelle demande d'annulation a été soumise</h2>

        <p>
            La demande d'annulation a été rédigée par <span class="highlight">{{ employee }}</span>.
        </p>

        {% if userComment %}
            <p><b>Commentaire de {{ employeeName }}:</b> {{ userComment }}</p>
        {% endif %}

        <p>
            Vous pouvez consulter les détails dans l’interface d’administration :
            <br>
            <a href="{{ absolute_url(path('app_login')) }}">Portail ERP</a>
        </p>

        <div class="footer">
            &copy; {{ 'now'|date('Y') }} TempoRH. Tous droits réservés.
        </div>

    </div>
</div>
{% endblock %}
