{% extends 'notification/base.html.twig' %}

{% block title %}Demande de congé invalide{% endblock %}

{% block body %}
<div class="email-wrapper">
    <div class="email-content">

        <div class="login-logo">
            <img src="{{ absolute_url(asset('images/logo.png')) }}"
                 alt="TempoRH" width="150">
        </div>

        <h2>La demande de congé est invalide</h2>

        <p>
            La demande de congé de <span class="highlight">{{ employee }}</span> est invalide.
        </p>

        <div class="footer">
            &copy; {{ 'now'|date('Y') }} TempoRH. Tous droits réservés.
        </div>

    </div>
</div>
{% endblock %}
