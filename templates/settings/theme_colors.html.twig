{% set settings = app_settings() %}
<style>
    /* Couleurs choisies dans Paramètres → Personnalisation.
       Elles ne s'appliquent qu'à NOS éléments (--brand-*) : EasyAdmin garde ses propres couleurs. */
    :root:root {
        --brand-primary: {{ settings.primaryColor }};
        --brand-secondary: {{ settings.secondaryColor }};
        --brand-tertiary: {{ settings.tertiaryColor }};
    }
</style>
